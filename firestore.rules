rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Progreso del usuario: cada quien solo lee y escribe su propio documento.
    // (El ranking público se servirá luego desde una colección aparte de solo
    // lectura, para no exponer datos privados como el correo.)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ranking público: cualquier usuario autenticado puede leerlo; cada quien
    // solo escribe su propia entrada, y con campos validados (anti-manipulación:
    // no se pueden inyectar campos arbitrarios ni tipos inesperados).
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['displayName', 'photoUrl', 'score', 'updatedAt'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120;
    }

    // Todo lo demás queda denegado por defecto.
  }
}
